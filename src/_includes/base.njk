<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and title != "Journal" %}{{ title }} · {% endif %}StationSixADV</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <meta name="color-scheme" content="light dark">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="s6-page">

  <header class="s6-header">
    <div class="s6-container s6-header__inner">
      <a class="s6-wordmark wordmark" href="/">StationSix<span class="s6-wordmark__adv">ADV</span></a>
      <nav class="s6-nav" aria-label="Main">
        <a class="nav" href="/" {% if page.url != '/about/' and page.url != '/videos/' %}aria-current="page"{% endif %}>Journal</a>
        <a class="nav" href="/videos/" {% if page.url == '/videos/' %}aria-current="page"{% endif %}>Videos</a>
        <a class="nav" href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a>
      </nav>
    </div>
  </header>

  <main class="s6-main">
    {{ content | safe }}
  </main>

  <footer class="s6-footer">
    <div class="s6-container s6-footer__inner">
      <div>
        <p class="s6-footer__sign meta">StationSixADV. A rider's field journal.</p>
        <p class="s6-footer__legal meta">&copy; {{ "now" | year }} StationSixADV</p>
      </div>
      <ul class="s6-social" aria-label="Elsewhere">
        <li><a href="https://www.facebook.com/stationsix" target="_blank" rel="noopener" aria-label="StationSixADV on Facebook"><img src="/img/social/facebook-logo-white.png" alt="" width="20" height="20"></a></li>
        <li><a href="https://www.instagram.com/stationsix/" target="_blank" rel="noopener" aria-label="StationSixADV on Instagram"><img src="/img/social/instagram-glyph-white.svg" alt="" width="20" height="20"></a></li>
        {%- if videos.channelUrl %}
        <li><a href="{{ videos.channelUrl }}" target="_blank" rel="noopener" aria-label="StationSixADV on YouTube"><img src="/img/social/youtube-glyph-white.svg" alt="" width="20" height="20"></a></li>
        {%- endif %}
      </ul>
    </div>
  </footer>

</body>
</html>
